#!/bin/zsh
# ─────────────────────────────────────────────────────────────────────────────
#  metis-tui — Metis Quick Action Interactor
#  Quick Action の履歴を Collapsed（要約1行）で一覧し、選ぶとその文脈を
#  引き継いだ新しい永続セッションへ「昇格」する。一時チャット的な気軽さと
#  実際のセッションとしての永続性を両立させるのが狙い。
# ─────────────────────────────────────────────────────────────────────────────
emulate -L zsh
setopt no_unset

BIN="$HOME/.claude/bin"

# 行の形式(タブ区切り、--with-nth=1 で表示は1列目だけ):
#   1: 表示用の要約(icon mode 短い質問)
#   2: id
#   3: mode
#   4: 質問全文
#   5: 回答全文
build_rows() {
  "$BIN/metis-recent" 40 | jq -r '
    .[] | select(.status != "pending" or .answer != "") |
    (if .status=="done" then "✓" elif .status=="error" then "✕"
     elif .status=="cancelled" then "–" else "◌" end) as $icon |
    ($icon + "  " + .mode + "  " + ((.prompt // "") | gsub("[\n\r]"; " ") | .[0:70])) as $disp |
    [$disp, .id, .mode,
     ((.prompt // "") | gsub("[\n\r]"; " ")),
     ((.answer // "") | gsub("[\n\r]"; " "))] | @tsv'
}

while true; do
  rows="$(build_rows)"

  if [[ -z "$rows" ]]; then
    clear
    print "Metis の履歴はまだありません。"
    print "⌘⌥A / ⌘⌥V などで Quick Action を試してから戻ってきてください。"
    print; print "(何かキーを押すと終了)"
    read -k1 -s
    exit 0
  fi

  # fzf のプレースホルダは自動でシェルエスケープされるので、フィールドの
  # 中身に引用符やバッククォートが含まれていても安全に展開できる。
  sel="$(print -r -- "$rows" | fzf --ansi --delimiter='\t' --with-nth=1 \
          --height=90% --border=rounded --layout=reverse \
          --header='Enter: この続きから新しい永続セッションを開始  /  Esc・Ctrl-C: 戻る' \
          --prompt='Metis ❯ ' \
          --preview='printf "\033[1;33m[%s]\033[0m\n\n\033[1mQ:\033[0m %s\n\n\033[36mA:\033[0m %s\n" {3} {4} {5}' \
          --preview-window='right:58%:wrap')"
  rc=$?
  (( rc != 0 )) && exit 0
  [[ -n "$sel" ]] || exit 0

  IFS=$'\t' read -r disp id mode prompt answer <<< "$sel"

  clear
  print "── 選択したやり取り ──────────────────────────"
  print "モード: $mode"
  print "Q: $prompt"
  print "A: $answer"
  print "────────────────────────────────────────────"
  print "Enter: このまま新しい永続セッションへ昇格 / q: 一覧に戻る"
  read -k1 -s key
  [[ "$key" == "q" ]] && continue

  # ─── 昇格: 新しい tmux セッションで claude を起動し、直前のやり取りを ────
  #      最初のユーザーターンとして引き継がせる（「続きから話せる」を実現）。
  #      seed はファイル経由で渡す（引用符やバッククォートを含む回答でも壊れない）。
  name="metis-$(date +%H%M%S)"
  seed_file="$(mktemp "$HOME/.claude/metis/.seed.XXXXXX")"
  {
    print -r -- "直前の Quick Action（${mode}）でのやり取りです。ここから続けて話しましょう。"
    print
    print -r -- "質問: $prompt"
    print
    print -r -- "回答: $answer"
  } > "$seed_file"

  tmux new-session -d -s "$name" -c "$HOME" 2>/dev/null
  tmux send-keys -t "$name" "claude \"\$(cat '$seed_file')\"; rm -f '$seed_file'" C-m 2>/dev/null

  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$name"
  else
    tmux attach-session -t "$name"
  fi
  exit 0
done
