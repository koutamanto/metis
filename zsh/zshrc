# ═════════════════════════════════════════════════════════════════════════════
#  ~/.zshrc
#  設定本体は ~/.config/zsh/ に分割:
#    aliases.zsh / functions.zsh / ccx.zsh / completions/
# ═════════════════════════════════════════════════════════════════════════════

# ─── PATH ────────────────────────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$HOME/.lmstudio/bin:$PATH"

# ─── 基本環境変数 ────────────────────────────────────────────────────────────
export LANG=ja_JP.UTF-8
export EDITOR="${EDITOR:-vim}"
export VISUAL="$EDITOR"
export PAGER=less
export LESS='-R -F -X -i -M'
export MANPAGER="sh -c 'col -bx | bat -l man -p'"   # man を bat で色付け
export MANROFFOPT='-c'
export BAT_THEME="tokyonight_night"
export HOMEBREW_NO_ENV_HINTS=1

# ─── 履歴 ────────────────────────────────────────────────────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY          # タイムスタンプを記録
setopt SHARE_HISTORY             # 複数ペインで履歴を共有
setopt INC_APPEND_HISTORY        # 実行のたびに追記
setopt HIST_IGNORE_ALL_DUPS      # 重複は古い方を消す
setopt HIST_IGNORE_SPACE         # 空白始まりは残さない
setopt HIST_REDUCE_BLANKS        # 余分な空白を詰める
setopt HIST_VERIFY               # 履歴展開は即実行せず一度見せる
setopt HIST_FIND_NO_DUPS

# ─── zsh の挙動 ──────────────────────────────────────────────────────────────
setopt AUTO_CD                   # ディレクトリ名だけで cd
setopt AUTO_PUSHD                # cd を履歴スタックに積む
setopt PUSHD_IGNORE_DUPS
setopt EXTENDED_GLOB             # 高度なグロブ
setopt GLOB_DOTS                 # ドットファイルもグロブ対象
setopt NO_CASE_GLOB              # グロブは大文字小文字を無視
setopt INTERACTIVE_COMMENTS      # 対話シェルでも # コメント可
setopt NO_BEEP
setopt NUMERIC_GLOB_SORT
unsetopt FLOW_CONTROL            # Ctrl+S / Ctrl+Q を解放

# ─── Oh My Zsh ───────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""                     # プロンプトは Starship に任せる
ZSH_DISABLE_COMPFIX="true"       # 毎回の compaudit を省く（約120ms）
DISABLE_AUTO_TITLE="false"
COMPLETION_WAITING_DOTS="true"
HIST_STAMPS="yyyy-mm-dd"
zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 14

plugins=(
  git
  gh
  brew
  macos
  bundler
  rails
  npm
  extract
  colored-man-pages
  command-not-found
)
# 自前の補完ディレクトリは omz(内部で compinit を実行)より前に追加する
fpath=("$HOME/.config/zsh/completions" $fpath)
source "$ZSH/oh-my-zsh.sh"

# ─── 補完 ────────────────────────────────────────────────────────────────────
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:warnings'     format '%F{red}-- 該当なし --%f'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.cache/zsh/compcache"
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'

# ─── ランタイム / ツール初期化 ───────────────────────────────────────────────
# mise を使い始めたら次の行を有効化する（起動が約60ms 伸びる）
# (( $+commands[mise] ))   && eval "$(mise activate zsh)"
(( $+commands[rbenv] ))    && eval "$(rbenv init - zsh)"
(( $+commands[direnv] ))   && eval "$(direnv hook zsh)"
(( $+commands[zoxide] ))   && eval "$(zoxide init zsh --cmd cd)"   # cd が zoxide に
(( $+commands[starship] )) && eval "$(starship init zsh)"

# ─── fzf ─────────────────────────────────────────────────────────────────────
if (( $+commands[fzf] )); then
  source <(fzf --zsh)
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
  export FZF_DEFAULT_OPTS="
    --height 60% --layout=reverse --border=rounded --info=inline --marker='▏'
    --pointer='▶' --prompt='  ' --cycle
    --color=bg+:#292e42,bg:-1,spinner:#bb9af7,hl:#7aa2f7
    --color=fg:#c0caf5,header:#7aa2f7,info:#e0af68,pointer:#bb9af7
    --color=marker:#9ece6a,fg+:#c0caf5,prompt:#7dcfff,hl+:#7dcfff
    --color=border:#565f89
    --bind='ctrl-/:toggle-preview,ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down'"
  export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range :300 {} 2>/dev/null || eza -T --icons=always --color=always {} 2>/dev/null'"
  export FZF_ALT_C_OPTS="--preview 'eza -T --level=2 --icons=always --color=always {}'"
fi

# ─── atuin (Ctrl+R をシェル横断の高機能履歴に置き換え) ──────────────────────
if (( $+commands[atuin] )); then
  eval "$(atuin init zsh --disable-up-arrow)"   # ↑ は通常の履歴のまま
fi

# ─── zsh プラグイン (syntax-highlighting は必ず最後) ────────────────────────
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#565f89'
source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# ─── キーバインド ────────────────────────────────────────────────────────────
bindkey -e                                   # Emacs キーバインド
bindkey '^[[A' history-search-backward       # ↑ で前方一致検索
bindkey '^[[B' history-search-forward        # ↓ で前方一致検索
bindkey '^[[1;3D' backward-word              # Option+←
bindkey '^[[1;3C' forward-word               # Option+→
bindkey '^[^?' backward-kill-word            # Option+Backspace
bindkey '^U' backward-kill-line
bindkey '^[m' autosuggest-accept             # Option+M で候補を確定

# Ctrl+X Ctrl+E でコマンドをエディタで編集
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# ─── 分割設定を読み込み ──────────────────────────────────────────────────────
for f in "$HOME"/.config/zsh/*.zsh; do
  [[ -r "$f" ]] && source "$f"
done
unset f
